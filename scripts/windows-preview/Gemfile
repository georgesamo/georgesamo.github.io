# Local preview on Windows without a C toolchain.
# Jekyll's live-reload (em-websocket -> eventmachine) needs native compilation;
# we never use live-reload, so a no-op stand-in is used here instead.
# GitHub Actions builds with the real ../../Gemfile.
source "https://rubygems.org"

gem "jekyll", "~> 4.3.4"   # keep in sync with ../../Gemfile
gem "em-websocket", path: "em-websocket-stub"
gem "google-protobuf", "~> 3.25"  # prebuilt for Windows, no bigdecimal compile
gem "webrick", "~> 1.8"
gem "tzinfo", ">= 1", "< 3"
gem "tzinfo-data"

group :jekyll_plugins do
  gem "jekyll-seo-tag", "~> 2.8"
  gem "jekyll-sitemap", "~> 1.4"
end
